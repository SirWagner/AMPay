@model AMPay.Web.Models.FinancialStepModel
@{
    var wizard = (AMPay.Web.Models.WizardContext)ViewBag.Wizard;
    ViewData["Title"] = "Financial";

    string R(decimal value) => "R " + value.ToString("N2");
    var non = Model.NetOfNet;
}

<div class="page-head">
    <h1>@wizard.ClientName</h1>
    <p class="lede">
        @OnboardingSteps.Caption(OnboardingStep.Financial) &mdash; financial. Income against the monthly budget: the basis of the
        affordability assessment the National Credit Act requires.
    </p>
</div>

<div class="wizard">
    <partial name="_WizardNav" model="wizard" />

    <div>
        <form asp-action="Financial" method="post" id="financialForm">
            <input type="hidden" asp-for="ClientId" />

            @* Enter in any field submits the form through its first submit button. Without
               this, that would be "Remove" or "Add expense" rather than Save. *@
            <button type="submit" name="command" value="save" class="default-submit" tabindex="-1" aria-hidden="true"></button>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="card">
                <div class="card-head"><h2>Income</h2></div>
                <div class="card-body">
                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="GrossMonthlyIncome"></label>
                            <input asp-for="GrossMonthlyIncome" type="number" step="0.01" min="0" />
                            <span asp-validation-for="GrossMonthlyIncome" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="NetMonthlyIncome"></label>
                            <input asp-for="NetMonthlyIncome" type="number" step="0.01" min="0" />
                            <span class="hint">Own salary: take-home pay. List the payslip deductions in the budget below.</span>
                            <span asp-validation-for="NetMonthlyIncome" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="OtherIncome"></label>
                            <input asp-for="OtherIncome" type="number" step="0.01" min="0" />
                            <span class="hint">Counts towards NET of NET and affordability.</span>
                        </div>
                        <div class="field">
                            <label asp-for="OtherIncomeSource"></label>
                            <input asp-for="OtherIncomeSource" />
                        </div>
                    </div>
                </div>
            </div>

            @{
                var groups = AMPay.Domain.Credit.BudgetCategories.Groups;
                string GroupOf(AMPay.Web.Models.BudgetLineModel l) => l.IsCustom ? "Added for this client" : l.Group ?? "Other";
                var order = groups.Concat(new[] { "Added for this client" }).ToList();
                var empty = Model.Budget.Count(l => !(l.Amount > 0) && !l.IsMain && !l.IsCustom);
                string GroupId(string g) => "bg-" + new string(g.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
            }
            <div class="card" id="budget">
                <div class="card-head flex-between">
                    <h2>Budget</h2>
                    <button type="button" class="btn btn-outline btn-sm" id="budgetFold" aria-pressed="false"
                            data-empty="@empty">Hide the @empty empty lines</button>
                </div>
                <div class="card-body">
                    <p class="muted small mt-0">
                        Monthly amounts. Go through every line with the client: each is saved, a zero included, so the file
                        shows it was asked about. Payslip deductions explain how gross pay becomes net pay and are not taken
                        off again. Debt instalments are deducted on top of living expenses, never counted towards the
                        Regulation 23A minimum.
                    </p>

                    <div class="table-wrap">
                        <table class="data budget-table" id="budgetTable">
                            <thead>
                            <tr>
                                <th>Description</th>
                                <th>Type</th>
                                <th>Note</th>
                                <th class="num">Amount</th>
                                <th></th>
                            </tr>
                            </thead>
                            @foreach (var g in order)
                            {
                                var rows = Enumerable.Range(0, Model.Budget.Count).Where(i => GroupOf(Model.Budget[i]) == g).ToList();
                                if (rows.Count == 0) { continue; }
                                <tbody class="budget-group" id="@GroupId(g)">
                                <tr class="budget-group-head">
                                    <th colspan="3">
                                        @g
                                        @if (g == AMPay.Domain.Credit.BudgetCategories.Payslip)
                                        {
                                            <span class="muted small" style="font-weight:400;">&middot; already out of net pay</span>
                                        }
                                    </th>
                                    <th class="num budget-subtotal"></th>
                                    <th></th>
                                </tr>
                                @foreach (var i in rows)
                                {
                                    var line = Model.Budget[i];
                                    <tr class="budget-row @(line.IsMain || line.IsCustom ? "is-main" : "") @(line.Amount > 0 ? "" : "is-empty")">
                                        <td>
                                            <input type="hidden" name="Budget.Index" value="@i" />
                                            <input type="hidden" asp-for="Budget[i].Id" />
                                            <input type="hidden" asp-for="Budget[i].Category" />
                                            @if (line.IsCustom)
                                            {
                                                <input asp-for="Budget[i].Description" placeholder="What is it for?" aria-label="Expense description" />
                                                <span asp-validation-for="Budget[i].Description" class="field-error"></span>
                                            }
                                            else
                                            {
                                                <text>@line.Description</text>
                                                @if (line.Hint is not null)
                                                {
                                                    <div class="muted small">@line.Hint</div>
                                                }
                                            }
                                        </td>
                                        <td>
                                            @switch (line.Kind)
                                            {
                                                case BudgetLineKind.DebtInstalment: <span class="badge badge-navy">Debt</span> break;
                                                case BudgetLineKind.PayslipDeduction: <span class="badge badge-amber">Payslip</span> break;
                                                default: <span class="badge badge-grey">Expense</span> break;
                                            }
                                        </td>
                                        <td>
                                            <input asp-for="Budget[i].Note" aria-label="Note for @(line.Description ?? "expense")" />
                                        </td>
                                        <td class="num">
                                            <input asp-for="Budget[i].Amount" type="number" step="0.01" min="0" placeholder="0.00"
                                                   class="budget-amount" data-kind="@line.Kind"
                                                   aria-label="Amount for @(line.Description ?? "expense")" />
                                            <span asp-validation-for="Budget[i].Amount" class="field-error"></span>
                                        </td>
                                        <td>
                                            @if (line.IsCustom)
                                            {
                                                <button type="submit" name="command" value="remove:@i" formnovalidate
                                                        class="btn btn-danger btn-sm"
                                                        aria-label="Remove @(line.Description ?? "expense")">Remove</button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (g == AMPay.Domain.Credit.BudgetCategories.Payslip)
                                {
                                    <tr class="budget-check">
                                        <td colspan="5" class="small" id="payslipCheck"></td>
                                    </tr>
                                }
                                </tbody>
                            }
                            <tfoot>
                            <tr class="total">
                                <td colspan="3">Payslip deductions <span class="muted small">(explain gross to net; not deducted again)</span></td>
                                <td class="num" id="totalPayslip">@R(Model.TotalPayslipDeductions)</td>
                                <td></td>
                            </tr>
                            <tr class="total">
                                <td colspan="3">Living expenses</td>
                                <td class="num" id="totalExpense">@R(Model.TotalExpenses)</td>
                                <td></td>
                            </tr>
                            <tr class="total">
                                <td colspan="3">Debt instalments</td>
                                <td class="num" id="totalDebt">@R(Model.TotalDebtInstalments)</td>
                                <td></td>
                            </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="row-actions budget-add" style="margin-top:1rem;">
                        <input type="hidden" name="addLine" value="@AMPay.Domain.Credit.BudgetCategories.Custom" />
                        <button type="submit" name="command" value="add" formnovalidate class="btn btn-outline btn-sm">
                            + Add something else
                        </button>
                        <button type="submit" name="command" value="recalculate" formnovalidate class="btn btn-outline btn-sm">
                            Recalculate NET of NET
                        </button>
                    </div>
                </div>
            </div>

            <div class="card" id="netOfNet">
                <div class="card-head"><h2>NET of NET</h2></div>
                <div class="card-body">
                    @if (non is null)
                    {
                        <p class="muted small mb-0">Capture gross and net monthly income to see what is left each month.</p>
                    }
                    else
                    {
                        <table class="data net-of-net">
                            <tbody>
                            <tr><td>Net income</td><td class="num">@R(non.NetIncome)</td></tr>
                            @if (non.OtherIncome > 0)
                            {
                                <tr><td>Plus other income</td><td class="num">@R(non.OtherIncome)</td></tr>
                            }
                            <tr>
                                <td>
                                    Less living expenses
                                    <div class="muted small">
                                        @if (non.StatutoryMinimumApplied)
                                        {
                                            <text>Budget of @R(non.DeclaredExpenses) is below the Regulation 23A minimum of
                                                @R(non.StatutoryMinimumExpenses) for this income, so the minimum is used.</text>
                                        }
                                        else
                                        {
                                            <text>Budget; above the Regulation 23A minimum of @R(non.StatutoryMinimumExpenses).</text>
                                        }
                                    </div>
                                </td>
                                <td class="num">(@R(non.AppliedExpenses))</td>
                            </tr>
                            <tr><td>Less debt instalments</td><td class="num">(@R(non.DebtInstalments))</td></tr>
                            <tr class="total">
                                <td>NET of NET</td>
                                <td class="num">@R(non.NetOfNet)</td>
                            </tr>
                            </tbody>
                        </table>

                        <div class="alert @(non.NetOfNet > 0 ? "alert-success" : "alert-warn") small" style="margin-top:1rem;">
                            @if (non.NetOfNet > 0)
                            {
                                <text>A new loan's instalment must fit within <strong>@R(non.NetOfNet)</strong> a month.</text>
                            }
                            else
                            {
                                <text>Nothing is left to service a new instalment. Lending to this client would be reckless under s80 of the National Credit Act.</text>
                            }
                            Instalments on loans already held with us are deducted when a loan is assessed.
                        </div>

                        <p class="muted small mb-0" id="netOfNetStale" hidden>
                            Figures changed since this was calculated &mdash; recalculate or save to update it.
                        </p>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head"><h2>Banking relationship</h2></div>
                <div class="card-body">
                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="BankName"></label>
                            <input asp-for="BankName" />
                        </div>
                        <div class="field">
                            <label asp-for="YearsAtBank"></label>
                            <input asp-for="YearsAtBank" type="number" min="0" max="80" />
                        </div>
                    </div>
                </div>
                <div class="card-foot">
                    <button type="submit" name="command" value="save" class="btn btn-primary">Save and continue</button>
                    <a asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-outline">Skip to summary</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Live totals only. NET of NET needs the Regulation 23A bands, which live on the
        // server; rather than copy them here, the figure is marked stale until recalculated.
        (function () {
            var form = document.getElementById('financialForm');
            var fmt = new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            function total(kind) {
                var sum = 0;
                form.querySelectorAll('.budget-amount[data-kind="' + kind + '"]').forEach(function (el) {
                    var v = parseFloat(el.value);
                    if (!isNaN(v)) sum += v;
                });
                return 'R ' + fmt.format(sum);
            }

            function num(el) { var v = parseFloat(el && el.value); return isNaN(v) ? 0 : v; }
            function rand(v) { return 'R ' + fmt.format(v); }

            // Each group's subtotal, and whether a line is empty (for folding).
            function groups() {
                form.querySelectorAll('tbody.budget-group').forEach(function (g) {
                    var sum = 0;
                    g.querySelectorAll('.budget-amount').forEach(function (el) {
                        sum += num(el);
                        el.closest('tr').classList.toggle('is-empty', !(num(el) > 0));
                    });
                    g.querySelector('.budget-subtotal').textContent = sum > 0 ? rand(sum) : '';
                });
            }

            // Gross less the payslip deductions should come to about the net pay captured.
            function payslip() {
                var cell = document.getElementById('payslipCheck');
                if (!cell) return;
                var gross = num(document.getElementById('GrossMonthlyIncome')), net = num(document.getElementById('NetMonthlyIncome'));
                var ded = 0;
                form.querySelectorAll('.budget-amount[data-kind="PayslipDeduction"]').forEach(function (el) { ded += num(el); });
                if (!(gross > 0) || !(net > 0) || !(ded > 0)) {
                    cell.textContent = 'Enter the deductions from the payslip: gross less deductions should equal the net pay above.';
                    cell.className = 'small muted'; return;
                }
                var gap = gross - ded - net;
                cell.textContent = 'Gross ' + rand(gross) + ' less deductions ' + rand(ded) + ' = ' + rand(gross - ded) +
                    (Math.abs(gap) <= 100 ? '. Agrees with the net pay captured.'
                        : '; net pay captured is ' + rand(net) + '. ' + rand(Math.abs(gap)) + (gap > 0 ? ' of deductions is missing' : ' too much is deducted') + ': check the payslip.');
                cell.className = 'small ' + (Math.abs(gap) <= 100 ? 'budget-ok' : 'budget-warn');
            }

            function refresh() {
                document.getElementById('totalExpense').textContent = total('Expense');
                document.getElementById('totalDebt').textContent = total('DebtInstalment');
                document.getElementById('totalPayslip').textContent = total('PayslipDeduction');
                groups(); payslip();
            }

            form.addEventListener('input', function (e) {
                if (e.target.type !== 'number') return;
                refresh();
                var stale = document.getElementById('netOfNetStale');
                if (stale) stale.hidden = false;
            });

            // Folding hides empty lines on screen only: they are still posted and saved as zero.
            var table = document.getElementById('budgetTable'), fold = document.getElementById('budgetFold');
            function setFold(on) {
                table.classList.toggle('folded', on);
                fold.setAttribute('aria-pressed', on ? 'true' : 'false');
                var n = table.querySelectorAll('tr.budget-row.is-empty:not(.is-main)').length;
                fold.textContent = on ? 'Show every line (' + n + ' empty)' : 'Hide the ' + n + ' empty lines';
                try { localStorage.setItem('ampay.budget.folded', on ? '1' : '0'); } catch (e) { }
            }
            fold.addEventListener('click', function () { setFold(!table.classList.contains('folded')); });

            refresh();
            var saved = null;
            try { saved = localStorage.getItem('ampay.budget.folded'); } catch (e) { }
            setFold(saved === '1');
        })();
    </script>
}
