@model AMPay.Web.Models.FinancialStepModel
@{
    var wizard = (AMPay.Web.Models.WizardContext)ViewBag.Wizard;
    ViewData["Title"] = "Financial";
}

<div class="page-head">
    <h1>@wizard.ClientName</h1>
    <p class="lede">
        @OnboardingSteps.Caption(OnboardingStep.Financial) &mdash; financial. Income against commitments: the basis of the
        affordability assessment the National Credit Act requires.
    </p>
</div>

<div class="wizard">
    <partial name="_WizardNav" model="wizard" />

    <div>
        <form asp-action="Financial" method="post">
            <input type="hidden" asp-for="ClientId" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="card">
                <div class="card-head"><h2>Income</h2></div>
                <div class="card-body">
                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="GrossMonthlyIncome"></label>
                            <input asp-for="GrossMonthlyIncome" type="number" step="0.01" min="0" />
                            <span asp-validation-for="GrossMonthlyIncome" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="NetMonthlyIncome"></label>
                            <input asp-for="NetMonthlyIncome" type="number" step="0.01" min="0" />
                            <span class="hint">Take-home pay after deductions.</span>
                            <span asp-validation-for="NetMonthlyIncome" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="OtherIncome"></label>
                            <input asp-for="OtherIncome" type="number" step="0.01" min="0" />
                        </div>
                        <div class="field">
                            <label asp-for="OtherIncomeSource"></label>
                            <input asp-for="OtherIncomeSource" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-head"><h2>Commitments</h2></div>
                <div class="card-body">
                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="TotalMonthlyExpenses"></label>
                            <input asp-for="TotalMonthlyExpenses" type="number" step="0.01" min="0" />
                        </div>
                        <div class="field">
                            <label asp-for="TotalMonthlyDebtRepayments"></label>
                            <input asp-for="TotalMonthlyDebtRepayments" type="number" step="0.01" min="0" />
                        </div>
                    </div>

                    @if (Model.Disposable is not null)
                    {
                        <div class="alert @(Model.Disposable > 0 ? "alert-success" : "alert-warn")" style="margin-top:1rem;">
                            Disposable income: <strong>R @Model.Disposable.Value.ToString("N2")</strong>
                            @if (Model.Disposable <= 0)
                            {
                                <text> &mdash; this client has nothing left to service a new instalment.</text>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head"><h2>Banking relationship</h2></div>
                <div class="card-body">
                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="BankName"></label>
                            <input asp-for="BankName" />
                        </div>
                        <div class="field">
                            <label asp-for="YearsAtBank"></label>
                            <input asp-for="YearsAtBank" type="number" min="0" max="80" />
                        </div>
                    </div>
                </div>
                <div class="card-foot">
                    <button type="submit" class="btn btn-primary">Save and continue</button>
                    <a asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-outline">Skip to summary</a>
                </div>
            </div>
        </form>
    </div>
</div>
