@model AMPay.Web.Models.BankAccountModel
@{
    var wizard = (AMPay.Web.Models.WizardContext)ViewBag.Wizard;
    var client = (Client)ViewBag.Client;
    var banks = ViewBag.Banks as IEnumerable<AMPay.Domain.Netcash.BankInfo> ?? Enumerable.Empty<AMPay.Domain.Netcash.BankInfo>();
    ViewData["Title"] = "Banking";
}

<div class="page-head">
    <h1>@wizard.ClientName</h1>
    <p class="lede">
        Step 4 of 13 &mdash; banking. The account DebiCheck will collect from. Only banks that
        participate in DebiCheck are listed.
    </p>
</div>

<div class="wizard">
    <partial name="_WizardNav" model="wizard" />

    <div>
        <div class="card">
            <div class="card-head">
                <h2>Accounts on file</h2>
                <span class="muted small">@client.BankAccounts.Count captured</span>
            </div>

            @if (client.BankAccounts.Count == 0)
            {
                <div class="empty">
                    No bank account yet. A DebiCheck mandate cannot be created without one.
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                        <tr>
                            <th>Bank</th><th>Account</th><th>Type</th><th>Holder</th>
                            <th>Verified</th><th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var a in client.BankAccounts.OrderByDescending(x => x.IsPrimary))
                        {
                            <tr>
                                <td>
                                    @a.BankName
                                    @if (a.IsPrimary)
                                    {
                                        <span class="badge badge-navy">Primary</span>
                                    }
                                </td>
                                <td class="mono">@a.MaskedAccountNumber<br /><span class="muted small">Branch @a.BranchCode</span></td>
                                <td>@a.AccountType</td>
                                <td>@a.AccountHolderName</td>
                                <td>
                                    @if (a.AvsVerified)
                                    {
                                        <span class="badge badge-green">Verified</span>
                                        <div class="muted small">@a.AvsVerifiedUtc?.ToString("dd MMM yyyy")</div>
                                    }
                                    else
                                    {
                                        <span class="badge badge-grey">Not verified</span>
                                    }
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <form asp-action="VerifyAccount" method="post">
                                            <input type="hidden" name="id" value="@client.Id" />
                                            <input type="hidden" name="accountId" value="@a.Id" />
                                            <button type="submit" class="btn btn-outline btn-sm">Verify (AVS)</button>
                                        </form>
                                        <form asp-action="RemoveBankAccount" method="post"
                                              onsubmit="return confirm('Remove this bank account?');">
                                            <input type="hidden" name="id" value="@client.Id" />
                                            <input type="hidden" name="accountId" value="@a.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <form asp-action="AddBankAccount" method="post">
            <input type="hidden" asp-for="ClientId" />

            <div class="card">
                <div class="card-head"><h2>Add a bank account</h2></div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="AccountHolderName"></label>
                            <input asp-for="AccountHolderName" maxlength="30" />
                            <span class="hint">As the bank holds it. Netcash allows 30 characters.</span>
                            <span asp-validation-for="AccountHolderName" class="field-error"></span>
                        </div>

                        <div class="field">
                            <label asp-for="BankName"></label>
                            <select asp-for="BankName" id="bankSelect">
                                <option value="">&mdash; choose a bank &mdash;</option>
                                @foreach (var b in banks)
                                {
                                    <option value="@b.Name" data-branch="@b.DefaultBranchCode">@b.Name</option>
                                }
                            </select>
                            <span asp-validation-for="BankName" class="field-error"></span>
                        </div>

                        <div class="field">
                            <label asp-for="BranchCode"></label>
                            <input asp-for="BranchCode" id="branchCode" maxlength="6" inputmode="numeric" />
                            <span class="hint">Universal branch code, filled in from the bank you pick.</span>
                            <span asp-validation-for="BranchCode" class="field-error"></span>
                        </div>

                        <div class="field">
                            <label asp-for="AccountNumber"></label>
                            <input asp-for="AccountNumber" maxlength="16" inputmode="numeric" autocomplete="off" />
                            <span asp-validation-for="AccountNumber" class="field-error"></span>
                        </div>

                        <div class="field">
                            <label asp-for="AccountType"></label>
                            <select asp-for="AccountType" asp-items="Html.GetEnumSelectList<BankAccountType>()"></select>
                            <span class="hint">Netcash accepts cheque or savings only.</span>
                        </div>
                    </div>

                    <div class="check" style="margin-top:1rem;">
                        <input asp-for="IsPrimary" type="checkbox" />
                        <label asp-for="IsPrimary"></label>
                    </div>
                </div>
                <div class="card-foot">
                    <button type="submit" class="btn btn-primary">Add account</button>
                    <a asp-action="Payback" asp-route-id="@Model.ClientId" class="btn btn-navy">Continue to payback</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Fill the universal branch code when a bank is chosen; the operator can still override it.
        document.getElementById('bankSelect')?.addEventListener('change', function () {
            var branch = this.options[this.selectedIndex]?.dataset.branch;
            var field = document.getElementById('branchCode');
            if (branch && field && !field.value) field.value = branch;
        });
    </script>
}
