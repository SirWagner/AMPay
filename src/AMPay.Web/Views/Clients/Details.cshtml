@model Client
@{
    var wizard = (AMPay.Web.Models.WizardContext)ViewBag.Wizard;
    ViewData["Title"] = Model.FullName;
    var netOfNet = ViewBag.NetOfNet as NetOfNetView;
    var mobile = Model.Addresses.Select(a => a.MobileNumber).FirstOrDefault(m => !string.IsNullOrWhiteSpace(m));
    var primary = Model.BankAccounts.FirstOrDefault(a => a.IsPrimary) ?? Model.BankAccounts.FirstOrDefault();

    var idAccepted = Model.Documents.Any(d =>
        d.DocumentType == DocumentType.IdDocument && d.ReviewStatus == DocumentReviewStatus.Approved);
    var payslipAccepted = Model.Documents.Any(d =>
        d.DocumentType == DocumentType.Payslip && d.ReviewStatus == DocumentReviewStatus.Approved);

    // Status alone is not enough: clients onboarded before document review existed carry
    // the Onboarded status with no documents on file. Mirrors the check LoansController makes.
    var canRaiseLoan = ClientStatusInfo.CanBorrow(Model.Status) && idAccepted && payslipAccepted;
}

<div class="page-head flex-between">
    <div>
        <h1>@Model.FullName</h1>
        <p class="lede">
            Client <span class="mono">@Model.ClientNumber</span> &middot;
            <partial name="_ClientStatus" model="Model.Status" />
        </p>
    </div>
    <div class="row-actions">
        @if (Model.Status is ClientStatus.Draft or ClientStatus.Captured)
        {
            <form asp-action="Activate" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-primary">Complete onboarding</button>
            </form>
        }
        else if (canRaiseLoan)
        {
            <a asp-controller="Loans" asp-action="Create" asp-route-clientId="@Model.Id"
               class="btn btn-primary">Raise a loan</a>
        }
        <a asp-controller="Documents" asp-action="Client" asp-route-id="@Model.Id" class="btn btn-outline">Documents</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline">Edit</a>
    </div>
</div>

<div class="wizard">
    <partial name="_WizardNav" model="wizard" />

    <div>
        @if (Model.Status == ClientStatus.Draft)
        {
            <div class="alert alert-info">
                Onboarding is not yet complete. A bank account, a mobile number and POPIA
                consent are required before this client can be onboarded and credit advanced.
            </div>
        }

        <div class="card">
            <div class="card-head"><h2>Ready for DebiCheck?</h2></div>
            <div class="card-body">
                <table class="data">
                    <tbody>
                    <tr>
                        <td>Bank account captured</td>
                        <td>@Html.Raw(Model.BankAccounts.Count > 0
                                ? "<span class='badge badge-green'>Yes</span>"
                                : "<span class='badge badge-red'>Missing</span>")</td>
                        <td class="muted small">@(primary is null ? "" : $"{primary.BankName} {primary.MaskedAccountNumber}")</td>
                    </tr>
                    <tr>
                        <td>Account verified (AVS)</td>
                        <td>@Html.Raw(primary?.AvsVerified == true
                                ? "<span class='badge badge-green'>Verified</span>"
                                : "<span class='badge badge-grey'>Not verified</span>")</td>
                        <td class="muted small">Optional, but it prevents a failed first collection.</td>
                    </tr>
                    <tr>
                        <td>Mobile number</td>
                        <td>@Html.Raw(!string.IsNullOrWhiteSpace(mobile)
                                ? "<span class='badge badge-green'>Yes</span>"
                                : "<span class='badge badge-red'>Missing</span>")</td>
                        <td class="muted small">@mobile</td>
                    </tr>
                    <tr>
                        <td>POPIA consent</td>
                        <td>@Html.Raw(Model.OtherDetails?.DataProcessingConsent == true
                                ? "<span class='badge badge-green'>Given</span>"
                                : "<span class='badge badge-red'>Missing</span>")</td>
                        <td class="muted small">@Model.OtherDetails?.DataProcessingConsentUtc?.ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <td>Identity document accepted</td>
                        <td>@Html.Raw(idAccepted
                                ? "<span class='badge badge-green'>Accepted</span>"
                                : "<span class='badge badge-amber'>Outstanding</span>")</td>
                        <td class="muted small">
                            <a asp-controller="Documents" asp-action="Client" asp-route-id="@Model.Id">Manage documents</a>
                        </td>
                    </tr>
                    <tr>
                        <td>Payslip accepted</td>
                        <td>@Html.Raw(payslipAccepted
                                ? "<span class='badge badge-green'>Accepted</span>"
                                : "<span class='badge badge-amber'>Outstanding</span>")</td>
                        <td class="muted small">Both are required before a loan can be raised.</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.25rem;">
            <div class="card">
                <div class="card-head"><h3>Identity</h3></div>
                <div class="card-body">
                    <table class="data">
                        <tbody>
                        <tr><td class="muted">ID number</td><td class="mono">@AMPay.Domain.Validation.SaIdNumber.Mask(Model.IdNumber)</td></tr>
                        <tr><td class="muted">Date of birth</td><td>@Model.DateOfBirth?.ToString("dd MMM yyyy")</td></tr>
                        <tr><td class="muted">Gender</td><td>@Model.Gender</td></tr>
                        <tr><td class="muted">Marital status</td><td>@Model.MaritalStatus</td></tr>
                        <tr><td class="muted">Language</td><td>@Model.PreferredLanguage</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-head"><h3>Affordability</h3></div>
                <div class="card-body">
                    @if (Model.Financial is null)
                    {
                        <p class="muted small mb-0">Not captured.</p>
                    }
                    else
                    {
                        <table class="data">
                            <tbody>
                            <tr><td class="muted">Gross income</td><td class="num">R @(Model.Financial.GrossMonthlyIncome?.ToString("N2") ?? "-")</td></tr>
                            <tr><td class="muted">Net income</td><td class="num">R @(Model.Financial.NetMonthlyIncome?.ToString("N2") ?? "-")</td></tr>
                            @if (Model.Financial.OtherIncome > 0)
                            {
                                <tr><td class="muted">Other income</td><td class="num">R @Model.Financial.OtherIncome.Value.ToString("N2")</td></tr>
                            }
                            <tr><td class="muted">Budgeted expenses</td><td class="num">R @(Model.Financial.TotalMonthlyExpenses?.ToString("N2") ?? "-")</td></tr>
                            <tr><td class="muted">Debt instalments</td><td class="num">R @(Model.Financial.TotalMonthlyDebtRepayments?.ToString("N2") ?? "-")</td></tr>
                            @if (netOfNet is not null)
                            {
                                @if (netOfNet.StatutoryMinimumApplied)
                                {
                                    <tr>
                                        <td class="muted">Regulation 23A minimum used</td>
                                        <td class="num">R @netOfNet.StatutoryMinimumExpenses.ToString("N2")</td>
                                    </tr>
                                }
                                <tr>
                                    <td><strong>NET of NET</strong></td>
                                    <td class="num"><strong>R @netOfNet.NetOfNet.ToString("N2")</strong></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <h3>Loans</h3>
                @if (canRaiseLoan)
                {
                    <a asp-controller="Loans" asp-action="Create" asp-route-clientId="@Model.Id"
                       class="btn btn-primary btn-sm">Raise a loan</a>
                }
            </div>
            @if (Model.Loans.Count == 0)
            {
                <div class="empty">
                    @if (canRaiseLoan)
                    {
                        <text>No loans yet. This client is onboarded and can be offered credit.</text>
                    }
                    else if (ClientStatusInfo.CanBorrow(Model.Status))
                    {
                        <text>No loans. This client is marked onboarded, but their identity document
                        and payslip have not both been accepted &mdash;
                        <a asp-controller="Documents" asp-action="Client" asp-route-id="@Model.Id">review the documents</a>
                        before offering credit.</text>
                    }
                    else
                    {
                        <text>No loans. Credit can be offered once onboarding is complete and the
                        identity document and payslip have been accepted.</text>
                    }
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                        <tr>
                            <th>Loan</th><th>Package</th><th class="num">Amount</th>
                            <th class="num">Instalment</th><th>Term</th><th>Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var l in Model.Loans.OrderByDescending(l => l.CreatedUtc))
                        {
                            <tr>
                                <td class="mono"><a asp-controller="Loans" asp-action="Details" asp-route-id="@l.Id">@l.LoanNumber</a></td>
                                <td>@l.CreditPackage?.Name</td>
                                <td class="num">R @l.Principal.ToString("N2")</td>
                                <td class="num">R @l.FirstInstalment.ToString("N2")</td>
                                <td>@l.NumberOfInstalments mo</td>
                                <td><partial name="_LoanStatus" model="l.Status" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-head">
                <h3>DebiCheck mandates</h3>
                @if (ClientStatusInfo.CanBorrow(Model.Status))
                {
                    <a asp-controller="Mandates" asp-action="Create" asp-route-clientId="@Model.Id"
                       class="btn btn-primary btn-sm">New mandate</a>
                }
            </div>
            @if (Model.Mandates.Count == 0)
            {
                <div class="empty">No mandates yet.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                        <tr><th>Reference</th><th>Route</th><th class="num">Amount</th><th>Status</th><th>Created</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var m in Model.Mandates.OrderByDescending(x => x.CreatedUtc))
                        {
                            <tr>
                                <td class="mono">
                                    <a asp-controller="Mandates" asp-action="Details" asp-route-id="@m.Id">@m.AccountReference</a>
                                </td>
                                <td class="small">@(m.MandateType == MandateType.DebiCheckTt1RealTime ? "TT1 real-time" : "TT2 batch")</td>
                                <td class="num">R @m.CollectionAmount.ToString("N2")</td>
                                <td><partial name="_MandateStatus" model="m.Status" /></td>
                                <td class="muted small">@m.CreatedUtc.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
