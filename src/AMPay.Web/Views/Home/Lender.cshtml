@model LenderDashboardViewModel
@{
    // Owner / customer administrator sees everything; loan officers (capturers) and viewers
    // see the operational parts - no income, capital or lent-vs-recovered.
    var showMoney = (bool)ViewBag.ShowFinancials;
    var reviewerOnly = (bool)ViewBag.ReviewerOnly;

    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string R(decimal v) => "R " + v.ToString("N0");
    string Day(DateTime d) => d.ToString("ddd d MMM");
    string Plural(int n, string one, string many) => $"{n:N0} {(n == 1 ? one : many)}";
    string Pct(decimal f) => (f * 100m).ToString("0.0") + "%";
    string H(decimal part, decimal max) => (max <= 0 ? 0m : 100m * part / max).ToString("0.##", inv);

    var c = Model.Collections;
    var k = Model.Kpis;
    // What fell due before today and has neither arrived nor failed: results still coming in.
    var awaitingResult = Math.Max(0m, c.Expected - c.StillScheduled - c.Collected - c.Failed);
    var chartMax = Math.Max(1m, Model.LentByMonth.Max(m => Math.Max(m.Lent, m.Recovered)));
    var arrearsMax = Math.Max(1m, Model.Arrears.Count == 0 ? 0m : Model.Arrears.Max(b => b.Amount));
    var failMax = Math.Max(1, Model.FailureReasons.Count == 0 ? 0 : Model.FailureReasons.Max(f => f.Count));
    var runTotal = (Debits: Model.UpcomingRuns.Sum(r => r.Debits), Amount: Model.UpcomingRuns.Sum(r => r.Amount),
                    Ready: Model.UpcomingRuns.Sum(r => r.MandatesReady));
}

<div class="dash lender-dash">

<div class="page-head flex-between">
    <div>
        <h1>@Model.TenantName</h1>
        <p class="lede">@Model.MonthLabel at a glance &middot; updated @Model.GeneratedUtc.AddHours(2).ToString("HH:mm") SAST, refreshes every minute.</p>
    </div>
    @if (showMoney)
    {
        <a asp-controller="LendingSettings" asp-action="Index" class="btn btn-outline btn-sm">Lending settings</a>
    }
</div>

@if (!reviewerOnly)
{
@* ================================================================ 1. collections *@
<section class="hero hero-dark lender-hero" aria-labelledby="collectTitle">
    <canvas class="network-bg" data-network="interactive" data-tone="dark" aria-hidden="true"></canvas>
    <div class="network-glow" aria-hidden="true"></div>

    @if (!Model.HasAnyLoans)
    {
        <div>
            <div class="hero-label" id="collectTitle"><span class="pulse-dot" aria-hidden="true"></span> @Model.TodaySast.ToString("MMMM") collections</div>
            <div class="hero-value" style="font-size:1.6rem;">No collections scheduled yet</div>
            <p class="hero-note">
                Collections start once loans are paid out.
                @if (!Model.HasActivePackages) { <text>Set up a <a asp-controller="CreditPackages" asp-action="Index">credit package</a></text> }
                else { <text>Your <a asp-controller="CreditPackages" asp-action="Index">credit packages</a> are ready</text> }
                @if (!Model.HasSelfServiceLink) { <text> and share your <a asp-controller="SelfService" asp-action="Index">self-service link</a></text> }
                else { <text> - share your <a asp-controller="SelfService" asp-action="Index">self-service link</a></text> }
                so clients can apply.
            </p>
        </div>
    }
    else
    {
        <div>
            <div class="hero-label" id="collectTitle"><span class="pulse-dot" aria-hidden="true"></span> @Model.TodaySast.ToString("MMMM") collections</div>
            <div class="hero-value tnum">@R(c.Collected) <span class="hero-of">of @R(c.Expected)</span></div>
            <p class="hero-note">Collected so far &middot; @Plural(c.ExpectedDebits, "debit", "debits") expected this month on loans being collected.</p>

            @if (c.Expected > 0 || c.Collected > 0)
            {
                <div class="seg-bar" role="img"
                     aria-label="@R(c.Collected) collected, @R(c.Failed) failed and not recovered, @R(awaitingResult) due with no result yet, @R(c.StillScheduled) still scheduled.">
                    <span class="seg seg-collected" style="flex-grow:@(((double)c.Collected).ToString(inv))"></span>
                    <span class="seg seg-failed" style="flex-grow:@(((double)c.Failed).ToString(inv))"></span>
                    <span class="seg seg-due" style="flex-grow:@(((double)awaitingResult).ToString(inv))"></span>
                    <span class="seg seg-sched" style="flex-grow:@(((double)c.StillScheduled).ToString(inv))"></span>
                </div>
                <ul class="seg-legend">
                    <li><span class="key seg-collected"></span> Collected <strong class="tnum">@R(c.Collected)</strong></li>
                    <li><span class="key seg-failed"></span> Failed <strong class="tnum">@R(c.Failed)</strong> <span class="tnum">(@c.FailedDebits)</span></li>
                    @if (awaitingResult > 0) { <li><span class="key seg-due"></span> Awaiting result <strong class="tnum">@R(awaitingResult)</strong></li> }
                    <li><span class="key seg-sched"></span> Still scheduled <strong class="tnum">@R(c.StillScheduled)</strong></li>
                </ul>
                @if (c.Collected > 0)
                {
                    <p class="hero-split tnum">DebiCheck @R(c.CollectedDebiCheck) &middot; Pay Now @R(c.CollectedPayNow) &middot; manual/EFT @R(c.CollectedManual)</p>
                }
            }
        </div>

        <dl class="hero-facts">
            <div>
                <dt>Next collection run</dt>
                @if (c.NextRun is { } nr)
                {
                    <dd class="tnum">@Day(nr.Date)<span class="fact-sub">@Plural(nr.Debits, "debit", "debits") &middot; @R(nr.Amount)</span></dd>
                }
                else { <dd>None left this month</dd> }
            </div>
            <div>
                <dt>Largest upcoming run</dt>
                @if (c.LargestRun is { } lr)
                {
                    <dd class="tnum">@Day(lr.Date)<span class="fact-sub">@R(lr.Amount)</span></dd>
                }
                else { <dd>-</dd> }
            </div>
            <div>
                <dt>Pay Now this month</dt>
                <dd class="tnum">@R(c.PayNowCollected)<span class="fact-sub">@Plural(c.PayNowCount, "checkout", "checkouts"), all purposes</span></dd>
            </div>
            @if (showMoney)
            {
                <div>
                    <dt>Capital available to lend</dt>
                    @if (c.CapitalAvailable is { } avail)
                    {
                        <dd class="tnum @(avail < 0 ? "fact-negative" : "")">@R(avail)<span class="fact-sub">of @R(c.LendingCapital!.Value) set aside &middot; @R(c.OutstandingPrincipal) out on loan</span></dd>
                    }
                    else
                    {
                        <dd class="not-tracked-dark">Not set<span class="fact-sub"><a asp-controller="LendingSettings" asp-action="Index">Set your lending capital</a> &middot; @R(c.OutstandingPrincipal) out on loan</span></dd>
                    }
                </div>
            }
        </dl>
    }
</section>

@* ================================================================ 2. KPIs *@
@if (!Model.HasAnyLoans)
{
    <p class="muted" style="margin:-.25rem 0 1.25rem;">
        Your loan book, income and arrears appear here once the first loan is approved and paid out.
    </p>
}
else
{
var thenLabel = k.ComparedToDate is { } td ? td.ToString("d MMM") : null;
<section class="stat-grid kpi-row" aria-label="Loan book">
    <div class="stat">
        <div class="label">Loan book outstanding</div>
        <div class="value tnum">@R(k.BookOutstanding)</div>
        <div class="note tnum">
            @Plural(k.ActiveLoans, "active loan", "active loans")
            @if (k.BookOutstandingThen is { } bookThen)
            {
                var diff = k.BookOutstanding - bookThen;
                if (Math.Round(diff, 0) == 0)
                {
                    <br /><text>No change since @thenLabel</text>
                }
                else
                {
                    <br /><span class="@(diff > 0 ? "trend-up" : "trend-down")">@(diff > 0 ? "▲" : "▼") @R(Math.Abs(diff))</span> <text>since @thenLabel</text>
                }
            }
        </div>
    </div>
    <div class="stat">
        <div class="label">Book in arrears</div>
        <div class="value tnum @(k.BookInArrears > 0 ? "warn" : "")">@R(k.BookInArrears)</div>
        <div class="note tnum">
            @if (k.ParRatio is { } par) { <text>@Pct(par) of the book &middot; </text> }
            @Plural(k.LoansInArrears, "loan", "loans") behind
            @if (k.ParRatioThen is { } parThen) { <br /><text>Was @Pct(parThen) on @thenLabel</text> }
            @if (k.LoansInArrears > 0) { <br /><a href="/Loans?filter=arrears">See loans in arrears</a> }
        </div>
    </div>
    <div class="stat">
        <div class="label">Disbursed this month</div>
        <div class="value tnum">@R(k.DisbursedPrincipalThisMonth)</div>
        <div class="note tnum">
            @Plural(k.DisbursedThisMonth, "loan", "loans")@(k.DisbursedThisMonth > 0 ? $" · avg {R(k.AverageLoanThisMonth)}" : "")<br />
            On pace for @k.OnPaceFor &middot; last month @k.DisbursedLastMonth
        </div>
    </div>
    @if (showMoney)
    {
        <div class="stat">
            <div class="label">Income this month</div>
            <div class="value accent tnum">@R(k.Income)</div>
            <div class="note tnum">
                Interest @R(k.Interest) &middot; initiation @R(k.InitiationFees)<br />
                Service fees @R(k.ServiceFees) &middot; credit life @R(k.CreditLife)
            </div>
        </div>
    }
</section>
@if (showMoney)
{
    <p class="muted small" style="margin-top:-.5rem;">
        Income is what the schedules charge this month plus initiation fees on loans paid out - charged, not necessarily collected.
        @if (k.ComparedToDate is null) { <text>Month-on-month comparisons appear once a snapshot from early this month exists.</text> }
    </p>
}
}
}

@* ================================================================ 3. needs action *@
@{
    var cards = reviewerOnly ? Model.Actions.Where(a => a.Key == "documents").ToList() : Model.Actions.ToList();
    var total = cards.Where(a => a.Count.HasValue).Sum(a => a.Count!.Value);
}
<section class="card" aria-labelledby="actionTitle">
    <div class="card-head flex-between">
        <h3 id="actionTitle">Needs action today</h3>
        <span class="badge @(total > 0 ? "badge-amber" : "badge-green")">@Plural(total, "item", "items")</span>
    </div>
    <div class="card-body action-grid">
        @foreach (var a in cards)
        {
            <div class="action-card @(a.Highlight && a.Count > 0 ? "highlight" : "") @(a.Count is null ? "untracked" : a.Count > 0 ? "has-work" : "")">
                <div class="action-title">@a.Title</div>
                @if (a.Count is { } n)
                {
                    <div class="action-count tnum">@n</div>
                }
                else
                {
                    <div class="action-count not-tracked">Not tracked yet</div>
                }
                <div class="action-context">@a.Context</div>
                @if (a.Url is not null && a.Count > 0)
                {
                    <a class="action-link" href="@a.Url">@a.LinkText &rarr;</a>
                }
            </div>
        }
    </div>
</section>

@if (!reviewerOnly)
{
@* ================================================================ 4. charts *@
<div class="chart-grid">
    @if (showMoney)
    {
        <section class="card" aria-labelledby="lentTitle">
            <div class="card-head"><h3 id="lentTitle">Money lent vs money recovered</h3></div>
            <div class="card-body">
                <p class="viz-sub">Principal paid out and money received per month, last six months.</p>
                @if (Model.LentByMonth.All(m => m.Lent == 0 && m.Recovered == 0))
                {
                    <p class="viz-empty">Nothing paid out or received in the last six months yet.</p>
                }
                else
                {
                    <ul class="pair-legend" aria-hidden="true">
                        <li><span class="key key-lent"></span> Lent</li>
                        <li><span class="key key-recovered"></span> Recovered</li>
                    </ul>
                    <div class="cols">
                        <div class="cols-plot">
                            <div class="cols-bars" style="--n:@Model.LentByMonth.Count" role="img"
                                 aria-label="Per month, lent then recovered: @string.Join("; ", Model.LentByMonth.Select(m => $"{m.Label} {R(m.Lent)} lent, {R(m.Recovered)} recovered"))">
                                @foreach (var m in Model.LentByMonth)
                                {
                                    <div class="col col-pair @(m.IsCurrentMonth ? "col-current" : "")"
                                         title="@m.Label@(m.IsCurrentMonth ? " (to date)" : ""): @R(m.Lent) lent (@Plural(m.Loans, "loan", "loans")), @R(m.Recovered) recovered">
                                        <span class="col-bar" style="--h:@H(m.Lent, chartMax)%"></span>
                                        <span class="col-bar recovered" style="--h:@H(m.Recovered, chartMax)%"></span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="cols-axis" style="--n:@Model.LentByMonth.Count" aria-hidden="true">
                            @foreach (var m in Model.LentByMonth) { <span>@m.Label@(m.IsCurrentMonth ? "*" : "")</span> }
                        </div>
                    </div>
                    <details class="viz-table">
                        <summary>Show as a table</summary>
                        <table class="data">
                            <thead><tr><th>Month</th><th class="num">Lent</th><th class="num">Recovered</th></tr></thead>
                            <tbody>
                            @foreach (var m in Model.LentByMonth)
                            {
                                <tr><td>@m.Label@(m.IsCurrentMonth ? "*" : "")</td><td class="num">@R(m.Lent)</td><td class="num">@R(m.Recovered)</td></tr>
                            }
                            </tbody>
                        </table>
                    </details>
                    <p class="muted small mb-0">* month to date</p>
                }
            </div>
        </section>
    }

    <section class="card" aria-labelledby="ageTitle">
        <div class="card-head"><h3 id="ageTitle">Arrears ageing</h3></div>
        <div class="card-body">
            <p class="viz-sub">Loans by days past their oldest unpaid instalment; amounts are each loan's whole balance.</p>
            @if (Model.Arrears.All(b => b.Loans == 0))
            {
                <p class="viz-empty">No loans in arrears.</p>
            }
            else
            {
                <ul class="hbar" aria-label="Arrears by age">
                    @for (var i = 0; i < Model.Arrears.Count; i++)
                    {
                        var b = Model.Arrears[i];
                        <li class="hbar-row">
                            <span class="hbar-label">@b.Label</span>
                            <span class="hbar-track">
                                <span class="hbar-fill" style="--f:@((b.Amount / arrearsMax).ToString("0.###", inv)); --c:var(--age-@i)"></span>
                                <span class="hbar-value">@R(b.Amount) &middot; @b.Loans</span>
                            </span>
                        </li>
                    }
                </ul>
            }
            @if (showMoney)
            {
                <p class="muted small mb-0" style="margin-top:.9rem;">
                    Written off in @Model.TodaySast.Year:
                    <strong class="tnum">@R(Model.WrittenOffThisYear.Amount)</strong>
                    <span class="tnum">(@Plural(Model.WrittenOffThisYear.Loans, "loan", "loans"))</span>
                </p>
            }
        </div>
    </section>
</div>

@* ================================================================ 5. collections detail *@
<div class="chart-grid">
    <section class="card" aria-labelledby="runsTitle">
        <div class="card-head"><h3 id="runsTitle">Upcoming collection runs</h3></div>
        @if (Model.UpcomingRuns.Count == 0)
        {
            <div class="card-body"><p class="viz-empty">No more debits due this month.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Date</th><th class="num">Debits</th><th class="num">Amount</th><th class="num">Mandates ready</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.UpcomingRuns)
                    {
                        <tr>
                            <td>@Day(r.Date)</td>
                            <td class="num tnum">@r.Debits</td>
                            <td class="num tnum">@R(r.Amount)</td>
                            <td class="num tnum">
                                @r.MandatesReady / @r.Debits
                                @if (!r.AllMandatesReady) { <span class="badge badge-amber" title="Some loans in this run have no authenticated DebiCheck mandate">@(r.Debits - r.MandatesReady) pending</span> }
                            </td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr class="total"><td>Rest of month</td><td class="num tnum">@runTotal.Debits</td><td class="num tnum">@R(runTotal.Amount)</td><td class="num tnum">@runTotal.Ready / @runTotal.Debits</td></tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <section class="card" aria-labelledby="whyTitle">
        <div class="card-head"><h3 id="whyTitle">Why debits failed</h3></div>
        <div class="card-body">
            <p class="viz-sub">Debits that ran this month and came back unpaid, by the bank's reason.</p>
            @if (Model.FailureReasons.Count == 0)
            {
                <p class="viz-empty">No failed debits this month.</p>
            }
            else
            {
                <ul class="hbar" aria-label="Failed debits by reason">
                    @foreach (var f in Model.FailureReasons)
                    {
                        <li class="hbar-row">
                            <span class="hbar-label">@f.Label</span>
                            <span class="hbar-track">
                                <span class="hbar-fill" style="--f:@(((decimal)f.Count / failMax).ToString("0.###", inv)); --c:var(--status-critical)"></span>
                                <span class="hbar-value">@f.Count &middot; @R(f.Amount)</span>
                            </span>
                        </li>
                    }
                </ul>
                var recovered = Model.FailureReasons.Sum(f => f.Count - f.Unrecovered);
                @if (recovered > 0)
                {
                    <p class="muted small mb-0" style="margin-top:.9rem;">@Plural(recovered, "has", "have") since been recovered.</p>
                }
            }
        </div>
    </section>
</div>

@* ================================================================ 6. growth & compliance *@
<div class="chart-grid">
    <section class="card" aria-labelledby="growthTitle">
        <div class="card-head"><h3 id="growthTitle">Growth this month</h3></div>
        <div class="card-body">
            <dl class="detail-list">
                <dt>Approval rate</dt>
                <dd class="tnum">
                    @if (Model.Growth.ApprovalRate is { } rate) { <strong>@rate.ToString("P0")</strong> <span class="muted small">(@Model.Growth.Approved approved, @Model.Growth.Declined declined)</span> }
                    else { <span class="muted">No decisions yet this month</span> }
                </dd>
                <dt>New vs repeat clients</dt>
                <dd class="tnum">@Model.Growth.NewClientLoans new &middot; @Model.Growth.RepeatClientLoans repeat <span class="muted small">(loans paid out)</span></dd>
                <dt>Self-service link</dt>
                <dd class="tnum">
                    @if (Model.Growth.Funnel is { } fn)
                    {
                        <ol class="funnel-steps">
                            <li><strong>@fn.LinkOpened</strong> opened</li>
                            <li><strong>@fn.Started</strong> started</li>
                            <li><strong>@fn.Submitted</strong> submitted</li>
                            <li><strong>@Model.Growth.PortalImported</strong> imported</li>
                            <li><strong>@Model.Growth.PortalDisbursed</strong> paid out</li>
                        </ol>
                    }
                    else
                    {
                        @Model.Growth.PortalImported <text> applications imported &rarr; </text> @Model.Growth.PortalDisbursed <text> paid out</text>
                        <div class="muted small">
                            @(Model.HasSelfServiceLink ? "Link opens are not available just now - the portal did not answer in time." : "No self-service link yet.")
                        </div>
                    }
                </dd>
            </dl>
        </div>
    </section>

    <section class="card" aria-labelledby="compTitle">
        <div class="card-head"><h3 id="compTitle">Compliance check</h3></div>
        <div class="card-body">
            @if (Model.Compliance.ActiveLoans == 0)
            {
                <p class="viz-empty">No active loans to check yet.</p>
            }
            else
            {
                var cpl = Model.Compliance;
                <ul class="status-list">
                    <li><span class="what">Affordability assessment on file</span><span class="count tnum @(cpl.WithAffordability < cpl.ActiveLoans ? "warn" : "")">@cpl.WithAffordability / @cpl.ActiveLoans</span></li>
                    <li><span class="what">Credit bureau check on file</span><span class="count tnum @(cpl.WithCreditCheck < cpl.ActiveLoans ? "warn" : "")">@cpl.WithCreditCheck / @cpl.ActiveLoans</span></li>
                    <li>
                        <span class="what">Active loans missing required documents</span>
                        <span class="count tnum @(cpl.MissingDocuments > 0 ? "warn" : "")">
                            @if (cpl.MissingDocuments > 0) { <a asp-controller="Documents" asp-action="Index">@cpl.MissingDocuments</a> } else { <text>0</text> }
                        </span>
                    </li>
                </ul>
            }
            <p class="muted small mb-0">NCR quarterly return export: not built yet.</p>
        </div>
    </section>
</div>
}

@* ================================================================ 7. onboarding pipeline *@
<section class="card" aria-labelledby="pipeTitle">
    <div class="card-head"><h3 id="pipeTitle">Onboarding pipeline</h3></div>
    <div class="card-body pipeline-row">
        @foreach (var s in Model.Pipeline)
        {
            <a class="pipeline-tile" asp-controller="Clients" asp-action="Index" asp-route-status="@s.Status">
                <span class="tnum">@s.Count</span>
                <span class="small">@s.Label</span>
            </a>
        }
    </div>
</section>

</div>
