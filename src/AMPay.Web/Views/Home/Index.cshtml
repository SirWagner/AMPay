@model AMPay.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var platformView = Model.IsPlatformUser && Model.TenantName is null;
}

<div class="page-head">
    <h1>@(Model.TenantName ?? "AM-Pay platform")</h1>
    <p class="lede">
        @if (platformView)
        {
            <text>Consolidated position across every customer trading under the AM-Pay Netcash ISV number.</text>
        }
        else
        {
            <text>Client onboarding, DebiCheck mandate origination and Pay Now collections.</text>
        }
    </p>
</div>

<div class="stat-grid">
    @if (platformView)
    {
        <div class="stat">
            <div class="label">Customers</div>
            <div class="value">@Model.CustomerCount</div>
            <div class="note">Trading under the AM-Pay ISV</div>
        </div>
    }

    <div class="stat">
        <div class="label">Onboarded</div>
        <div class="value accent">@Model.OnboardedClients</div>
        <div class="note">Verified and eligible for credit</div>
    </div>

    <div class="stat">
        <div class="label">Active</div>
        <div class="value">@Model.ActiveClients</div>
        <div class="note">Holding a disbursed loan</div>
    </div>

    <div class="stat">
        <div class="label">Awaiting verification</div>
        <div class="value">@Model.AwaitingVerification</div>
        <div class="note">Documents with a reviewer</div>
    </div>

    <div class="stat">
        <div class="label">Authenticated mandates</div>
        <div class="value">@Model.AuthenticatedMandates</div>
        <div class="note">Collectable today</div>
    </div>

    <div class="stat">
        <div class="label">Mandated per cycle</div>
        <div class="value">R @Model.MonthlyCollectionValue.ToString("N2")</div>
        <div class="note">Sum of authenticated mandates</div>
    </div>

    <div class="stat">
        <div class="label">Loan book advanced</div>
        <div class="value">R @Model.LoanBookPrincipal.ToString("N2")</div>
        <div class="note">@Model.DisbursedLoans disbursed</div>
    </div>
</div>

@if (platformView)
{
    <div class="card">
        <div class="card-body">
            <h3>Select a customer to begin</h3>
            <p class="muted small mb-0">
                You are signed in as a platform administrator and are not currently scoped to a
                customer account. Choose one to onboard clients or originate mandates on its behalf.
            </p>
        </div>
        <div class="card-foot">
            <a asp-controller="Tenants" asp-action="Index" class="btn btn-primary">Choose a customer</a>
            <a asp-controller="Tenants" asp-action="Create" class="btn btn-outline">Onboard a new customer</a>
        </div>
    </div>
}

<div class="chart-grid">
    <div class="card">
        <div class="card-head"><h3>Onboarding pipeline</h3></div>
        <div class="card-body">
            <p class="muted small">
                Where clients sit between first capture and a live loan. A drop between two
                stages is where the process is losing people.
            </p>
            <div class="chart-box"><canvas id="pipelineChart"></canvas></div>
        </div>
    </div>

    <div class="card">
        <div class="card-head"><h3>Mandate status</h3></div>
        <div class="card-body">
            @if (Model.MandateBreakdown.Count == 0)
            {
                <div class="empty">No mandates have been originated yet.</div>
            }
            else
            {
                <div class="chart-box"><canvas id="mandateChart"></canvas></div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-head"><h3>Clients captured per month</h3></div>
        <div class="card-body">
            <div class="chart-box"><canvas id="intakeChart"></canvas></div>
        </div>
    </div>

    <div class="card">
        <div class="card-head"><h3>Loan book by package</h3></div>
        <div class="card-body">
            @if (!Model.HasLoanBook)
            {
                <div class="empty">
                    No loans advanced yet. This fills in once the first agreement is disbursed.
                </div>
            }
            else
            {
                <div class="chart-box"><canvas id="bookChart"></canvas></div>
            }
        </div>
    </div>
</div>

@if (!platformView)
{
    <div class="chart-grid">
        <div class="card">
            <div class="card-head">
                <h3>Recent clients</h3>
                <a asp-controller="Clients" asp-action="Create" class="btn btn-primary btn-sm">Onboard a client</a>
            </div>
            @if (Model.RecentClients.Count == 0)
            {
                <div class="empty">No clients onboarded yet.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                        <tr><th>Number</th><th>Name</th><th>Status</th><th>Captured</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var c in Model.RecentClients)
                        {
                            <tr>
                                <td class="mono">@c.ClientNumber</td>
                                <td><a asp-controller="Clients" asp-action="Details" asp-route-id="@c.Id">@c.Name</a></td>
                                <td><partial name="_ClientStatus" model="c.Status" /></td>
                                <td class="muted small">@c.CreatedUtc.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-head">
                <h3>Recent mandates</h3>
                <a asp-controller="Mandates" asp-action="Index" class="btn btn-outline btn-sm">View all</a>
            </div>
            @if (Model.RecentMandates.Count == 0)
            {
                <div class="empty">No mandates have been originated yet.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                        <tr><th>Reference</th><th>Client</th><th class="num">Amount</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var m in Model.RecentMandates)
                        {
                            <tr>
                                <td class="mono">
                                    <a asp-controller="Mandates" asp-action="Details" asp-route-id="@m.Id">@m.AccountReference</a>
                                </td>
                                <td>@m.ClientName</td>
                                <td class="num">R @m.Amount.ToString("N2")</td>
                                <td><partial name="_MandateStatus" model="m.Status" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;

            // Pulled from ampay.css so the charts stay in step with the rest of the theme.
            var css = getComputedStyle(document.documentElement);
            var v = function (name, fallback) {
                return (css.getPropertyValue(name) || '').trim() || fallback;
            };

            var navy  = v('--navy', '#1e3674');
            var green = v('--green-accent', '#4aaa3c');
            var amber = v('--amber', '#b8860b');
            var red   = v('--red', '#c0392b');
            var muted = v('--text-muted', '#777');
            var border = v('--border', '#e5e5e5');

            var palette = [navy, green, amber, '#5b7bc4', red, '#7f8fa6', '#2d7a4e'];

            Chart.defaults.font.family =
                '-apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif';
            Chart.defaults.font.size = 12;
            Chart.defaults.color = muted;
            Chart.defaults.maintainAspectRatio = false;

            var rands = new Intl.NumberFormat('en-ZA', {
                style: 'currency', currency: 'ZAR', minimumFractionDigits: 2
            });

            function mount(id, config) {
                var el = document.getElementById(id);
                if (el) new Chart(el, config);
            }

            // ---- Onboarding pipeline ----
            var pipeline = @Html.Raw(Json.Serialize(Model.Pipeline));
            mount('pipelineChart', {
                type: 'bar',
                data: {
                    labels: pipeline.map(function (s) { return s.label; }),
                    datasets: [{
                        data: pipeline.map(function (s) { return s.value; }),
                        backgroundColor: navy,
                        borderRadius: 4,
                        barThickness: 22
                    }]
                },
                options: {
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { precision: 0 },
                            grid: { color: border }
                        },
                        y: { grid: { display: false } }
                    }
                }
            });

            // ---- Mandate status ----
            var mandates = @Html.Raw(Json.Serialize(Model.MandateBreakdown));
            mount('mandateChart', {
                type: 'doughnut',
                data: {
                    labels: mandates.map(function (s) { return s.label; }),
                    datasets: [{
                        data: mandates.map(function (s) { return s.value; }),
                        backgroundColor: palette,
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    cutout: '62%',
                    plugins: { legend: { position: 'right', labels: { boxWidth: 12 } } }
                }
            });

            // ---- Intake per month ----
            var intake = @Html.Raw(Json.Serialize(Model.ClientsByMonth));
            mount('intakeChart', {
                type: 'line',
                data: {
                    labels: intake.map(function (s) { return s.label; }),
                    datasets: [{
                        data: intake.map(function (s) { return s.value; }),
                        borderColor: green,
                        backgroundColor: 'rgba(74,170,60,.12)',
                        fill: true,
                        tension: .3,
                        pointRadius: 3,
                        pointBackgroundColor: green
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: border } },
                        x: { grid: { display: false } }
                    }
                }
            });

            // ---- Loan book by package ----
            var book = @Html.Raw(Json.Serialize(Model.LoanBookByPackage));
            mount('bookChart', {
                type: 'doughnut',
                data: {
                    labels: book.map(function (s) { return s.label; }),
                    datasets: [{
                        data: book.map(function (s) { return s.value; }),
                        backgroundColor: palette,
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'right', labels: { boxWidth: 12 } },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ctx.label + ': ' + rands.format(ctx.parsed);
                                }
                            }
                        }
                    }
                }
            });
        })();
    </script>
}
