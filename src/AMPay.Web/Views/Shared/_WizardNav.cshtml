@model AMPay.Web.Models.WizardContext
@{
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<div class="wizard-steps">
    @foreach (var (step, label, action) in OnboardingSteps.All)
    {
        var done = Model.CompletedSteps.Contains(step);
        var isCurrent = string.Equals(action, current, StringComparison.OrdinalIgnoreCase)
                        || (current == "General" && step == OnboardingStep.General)
                        || (current == "Edit" && step == OnboardingStep.General);

        var built = step <= OnboardingStep.OtherDetails;
        var cls = (isCurrent ? "active " : "") + (done ? "done" : "");

        @if (step == OnboardingStep.Documents)
        {
            // Documents live on their own controller: they outlive the capture wizard and
            // are worked by reviewers who have no business in the rest of it.
            <a class="@cls" asp-controller="Documents" asp-action="Client" asp-route-id="@Model.ClientId">
                <span class="num">@(done ? "✓" : OnboardingSteps.Position(step).ToString())</span>
                <span>@label</span>
            </a>
        }
        else if (step == OnboardingStep.Budgets)
        {
            // The budget is captured on the Financial step, against the income it spends.
            <a class="@cls" asp-controller="Clients" asp-action="Financial"
               asp-route-id="@Model.ClientId" asp-fragment="budget">
                <span class="num">@(done ? "✓" : OnboardingSteps.Position(step).ToString())</span>
                <span>@label</span>
            </a>
        }
        else if (built)
        {
            <a class="@cls" asp-controller="Clients" asp-action="@action" asp-route-id="@Model.ClientId">
                <span class="num">@(done && !isCurrent ? "✓" : OnboardingSteps.Position(step).ToString())</span>
                <span>@label</span>
            </a>
        }
        else
        {
            <a class="@cls" asp-controller="Clients" asp-action="Step"
               asp-route-id="@Model.ClientId" asp-route-step="@step" title="Not built yet">
                <span class="num">@OnboardingSteps.Position(step)</span>
                <span class="muted">@label</span>
            </a>
        }
    }
</div>
