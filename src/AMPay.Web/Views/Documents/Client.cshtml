@model AMPay.Web.Models.ClientDocumentsModel
@using AMPay.Web.Controllers
@{
    ViewData["Title"] = "Documents";

    string Tone(DocumentReviewStatus s) => s switch
    {
        DocumentReviewStatus.Approved => "badge-green",
        DocumentReviewStatus.Rejected => "badge-red",
        _ => "badge-amber"
    };

    string Label(DocumentReviewStatus s) => s switch
    {
        DocumentReviewStatus.Approved => "Accepted",
        DocumentReviewStatus.Rejected => "Rejected",
        _ => "Awaiting review"
    };
}

<div class="page-head row-between">
    <div>
        <h1>@Model.ClientName</h1>
        <p class="lede">
            Client <span class="mono">@Model.ClientNumber</span> &middot;
            <partial name="_ClientStatus" model="Model.ClientStatus" />
        </p>
    </div>
    <div class="row-actions">
        @if (Model.CanOpenClientFile)
        {
            <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId"
               class="btn btn-outline">Back to client</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline">Back to the queue</a>
        }
    </div>
</div>

@if (Model.Outstanding.Count > 0)
{
    <div class="alert alert-info">
        Still required before this client can be onboarded:
        <strong>@string.Join(", ", Model.Outstanding.Select(DocumentsController.Describe))</strong>.
    </div>
}
else if (Model.ClientStatus == ClientStatus.PendingVerification)
{
    <div class="alert alert-info">
        All required documents are on file and waiting for a reviewer. The client is
        onboarded automatically once the identity document and payslip are both accepted.
    </div>
}

<div class="chart-grid">
    @* A reviewer cannot upload - the POST would refuse them, so do not offer the form. *@
    @if (Model.CanOpenClientFile)
    {
    <div class="card">
        <div class="card-head"><h3>Upload a document</h3></div>
        <div class="card-body">
            <form asp-action="Upload" asp-route-id="@Model.ClientId" method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="field">
                    <label for="documentType">Document type</label>
                    <select id="documentType" name="documentType" required>
                        @* A signed agreement is recorded from its contract page, so it is tied to the pack it signs. *@
                        @foreach (var t in Enum.GetValues<DocumentType>().Where(t => t != DocumentType.SignedAgreement))
                        {
                            <option value="@t" selected="@(Model.Outstanding.Contains(t))">
                                @DocumentsController.Describe(t)
                            </option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label for="file">Files</label>
                    <input type="file" id="file" name="file" required multiple
                           accept="@Model.AcceptedExtensions" />
                    <span class="muted small">
                        Drag files here, or browse. @Model.AcceptedExtensions &middot; up to @Model.MaxFileSizeDisplay each.
                        A clear photograph of the original is acceptable. Each file is filed under the type chosen above.
                    </span>
                </div>

                @* Without the drag-and-drop library (no script), the plain form still uploads one file. *@
                <noscript><button type="submit" class="btn btn-primary">Upload</button></noscript>
                <button type="submit" class="btn btn-primary" id="classicUpload" hidden>Upload</button>
            </form>
        </div>
    </div>
    }

    <div class="card">
        <div class="card-head"><h3>Check the documents against this</h3></div>
        <div class="card-body">
            <dl class="detail-list">
                <dt>@(Model.IsSaIdNumber ? "SA ID number" : "Passport / registration")</dt>
                <dd class="mono">@Model.IdNumber</dd>

                @if (Model.DateOfBirth is not null)
                {
                    <dt>Date of birth</dt>
                    <dd>@Model.DateOfBirth.Value.ToString("dd MMMM yyyy")</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.MobileNumber))
                {
                    <dt>Mobile</dt>
                    <dd class="mono">@Model.MobileNumber</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.EmployerName))
                {
                    <dt>Employer</dt>
                    <dd>@Model.EmployerName @if (!string.IsNullOrWhiteSpace(Model.Occupation)) { <span class="muted">&middot; @Model.Occupation</span> }</dd>
                }

                @if (Model.GrossMonthlyIncome is not null)
                {
                    <dt>Gross monthly</dt>
                    <dd>R @Model.GrossMonthlyIncome.Value.ToString("N2")</dd>
                }

                @if (Model.NetMonthlyIncome is not null)
                {
                    <dt>Net monthly</dt>
                    <dd>R @Model.NetMonthlyIncome.Value.ToString("N2")</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.BankAccountHolder))
                {
                    <dt>Account holder</dt>
                    <dd>
                        @Model.BankAccountHolder
                        <div class="muted small">@Model.BankName &middot; <span class="mono">@Model.MaskedAccountNumber</span></div>
                    </dd>
                }
            </dl>

            <p class="muted small mb-0">
                The identity document must match the name and number above; the payslip must
                match the employer and income. Reject anything that does not reconcile.
            </p>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head"><h3>Documents on file</h3></div>

    @if (Model.Documents.Count == 0)
    {
        <div class="empty">Nothing uploaded yet.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr>
                    <th>Type</th>
                    <th>File</th>
                    <th>Uploaded</th>
                    <th>Status</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Documents)
                {
                    <tr>
                        <td><strong>@DocumentsController.Describe(d.DocumentType)</strong></td>
                        <td>
                            <a asp-action="Download" asp-route-id="@d.Id" target="_blank"
                               rel="noopener">@d.FileName</a>
                            <div class="muted small">@d.SizeDisplay</div>
                        </td>
                        <td class="muted small">
                            @d.UploadedUtc.ToString("dd MMM yyyy HH:mm")
                            @if (d.UploadedBy is not null)
                            {
                                <div>by @d.UploadedBy</div>
                            }
                        </td>
                        <td>
                            <span class="badge @Tone(d.ReviewStatus)">@Label(d.ReviewStatus)</span>
                            @if (d.ReviewedBy is not null)
                            {
                                <div class="muted small">@d.ReviewedBy, @d.ReviewedUtc?.ToString("dd MMM")</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(d.ReviewNotes))
                            {
                                <div class="muted small"><em>@d.ReviewNotes</em></div>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                @if (Model.CanReview && d.ReviewStatus != DocumentReviewStatus.Approved)
                                {
                                    <form asp-action="Review" asp-route-id="@d.Id" method="post"
                                          class="review-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="outcome" value="@DocumentReviewStatus.Approved" />
                                        <button type="submit" class="btn btn-primary btn-sm">Accept</button>
                                    </form>

                                    <form asp-action="Review" asp-route-id="@d.Id" method="post"
                                          class="review-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="outcome" value="@DocumentReviewStatus.Rejected" />
                                        <input type="text" name="notes" placeholder="Reason for rejection"
                                               class="inline-reason" />
                                        <button type="submit" class="btn btn-outline btn-sm">Reject</button>
                                    </form>
                                }
                                @if (d.ReviewStatus != DocumentReviewStatus.Approved)
                                {
                                    <form asp-action="Remove" asp-route-id="@d.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline btn-sm">Remove</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.CanOpenClientFile)
{
    @section Scripts {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/filepond@4.31.1/dist/filepond.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/filepond-plugin-image-preview@4.6.12/dist/filepond-plugin-image-preview.min.css" />
        <script src="https://cdn.jsdelivr.net/npm/filepond-plugin-file-validate-size@2.2.8/dist/filepond-plugin-file-validate-size.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/filepond-plugin-file-validate-type@1.2.9/dist/filepond-plugin-file-validate-type.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/filepond-plugin-image-preview@4.6.12/dist/filepond-plugin-image-preview.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/filepond@4.31.1/dist/filepond.min.js"></script>
        <script>
        (function () {
            var input = document.getElementById('file');
            if (!input || !window.FilePond) {
                // The library did not load (offline, blocked): fall back to the plain form.
                var b = document.getElementById('classicUpload'); if (b) b.hidden = false;
                if (input) input.removeAttribute('multiple');
                return;
            }

            FilePond.registerPlugin(FilePondPluginFileValidateSize, FilePondPluginFileValidateType, FilePondPluginImagePreview);

            // The types are set below as MIME types; the input's own ".pdf, .jpg" list would override them
            // and, written with spaces, reject everything.
            input.removeAttribute('accept');

            var form = input.form;
            var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            var typeSelect = document.getElementById('documentType');
            var uploaded = 0;

            var pond = FilePond.create(input, {
                name: 'file',
                allowMultiple: true,
                maxParallelUploads: 2,
                credits: false,
                storeAsFile: false,
                maxFileSize: '@(Model.MaxFileSizeBytes / 1024 / 1024)MB',
                acceptedFileTypes: ['application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'image/heic'],
                fileValidateTypeLabelExpectedTypes: 'PDF or a photograph',
                labelIdle: '<strong>Drag documents here</strong> or <span class="filepond--label-action">browse</span>',
                labelFileProcessingComplete: 'Uploaded - waiting for review',
                labelTapToCancel: 'tap to cancel',
                imagePreviewHeight: 120,
                server: {
                    process: {
                        url: '@Url.Action("UploadOne", new { id = Model.ClientId })',
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        // The document type chosen when the file is dropped travels with it.
                        ondata: function (data) { data.append('documentType', typeSelect.value); return data; },
                        onload: function () { uploaded++; return uploaded; },
                        onerror: function (body) {
                            try { return JSON.parse(body).message; } catch (e) { return 'Upload failed'; }
                        }
                    },
                    revert: null
                },
                labelFileProcessingError: function (error) { return error.body || 'Upload failed'; }
            });

            input.removeAttribute('required');
            form.addEventListener('submit', function (e) { e.preventDefault(); });

            // When every file has finished, refresh so the list and review status show them.
            pond.on('processfiles', function () { if (uploaded > 0) setTimeout(function () { location.reload(); }, 900); });
        })();
        </script>
    }
}
