@model AMPay.Web.Controllers.PasswordResetResult

<div class="page-head">
    <h1>Password reset</h1>
    <p class="lede">For @Model.FullName (@Model.Email).</p>
</div>

<div class="card" style="max-width:38rem;">
    <div class="card-body">
        <p>Their temporary password is:</p>
        <div class="contract-link">
            <input id="tempPassword" type="text" readonly value="@Model.TemporaryPassword" aria-label="Temporary password" class="mono" />
            <button type="button" class="btn btn-sm btn-outline"
                    onclick="navigator.clipboard.writeText(document.getElementById('tempPassword').value); this.textContent='Copied';">Copy</button>
        </div>
        <div class="alert alert-warn small" style="margin-top:1rem;">
            <strong>Shown once.</strong> It is not stored or emailed - copy it now and give it to them directly,
            preferably by phone or in person. They must replace it with their own password when they sign in.
            Any lockout on their account has been lifted, and sessions they already had open will end within minutes.
        </div>
    </div>
    <div class="card-foot">
        <a asp-action="Index" class="btn btn-primary">Back to users</a>
    </div>
</div>
