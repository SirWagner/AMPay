@model Tenant
@{
    var link = ViewBag.Link as string;
    var configured = (bool)ViewBag.PortalConfigured;
    var lender = Model.TradingName ?? Model.Name;
    var button = link is null ? null :
        $"<a href=\"{link}\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;padding:14px 26px;background:#3d9230;color:#fff;font-weight:600;font-family:Arial,sans-serif;border-radius:8px;text-decoration:none;\">Apply for a loan</a>";
}

<div class="page-head">
    <h1>Self-service link</h1>
    <p class="lede">
        Where @lender's clients apply on their own: they enter their details, upload their ID and payslip, ask for a loan
        or ask an advisor to call. Submitted applications arrive under <a asp-controller="Applications" asp-action="Index">Applications</a>.
    </p>
</div>

@if (!configured)
{
    <div class="alert alert-warn">
        The self-service portal is not connected to this AM-Pay yet. Set <span class="mono">Portal:BaseUrl</span> and
        <span class="mono">Portal:ApiKey</span>, then come back.
    </div>
}

<div class="card">
    <div class="card-head"><h3>Your link</h3></div>
    <div class="card-body">
        @if (link is null)
        {
            <p>@lender does not have a self-service link yet.</p>
        }
        else
        {
            <div class="contract-link">
                <input id="ssLink" type="text" readonly value="@link" aria-label="Self-service link" />
                <button type="button" class="btn btn-sm btn-outline" onclick="navigator.clipboard.writeText(document.getElementById('ssLink').value); this.textContent='Copied';">Copy</button>
                <a href="@link" target="_blank" rel="noopener" class="btn btn-sm btn-primary">Open</a>
            </div>
            <p class="muted small" style="margin-top:.6rem;">
                Code <span class="mono"><strong>@Model.SelfServiceCode</strong></span>.
                @if (Model.PortalSyncedUtc is { } synced)
                {
                    <text>Details and packages last sent to the portal @synced.ToLocalTime().ToString("dd MMM yyyy HH:mm").</text>
                }
            </p>
        }
    </div>
    <div class="card-foot contract-actions">
        @if (configured)
        {
            <form asp-action="Generate" method="post">
                @if (link is null)
                {
                    <button type="submit" class="btn btn-primary">Create self-service link</button>
                }
                else
                {
                    <button type="submit" class="btn btn-outline"
                            onclick="return confirm('Create a new link? The current link will stop working immediately, including the button on your website.');">Create a new link</button>
                }
            </form>
            @if (link is not null)
            {
                <form asp-action="Sync" method="post">
                    <button type="submit" class="btn btn-outline">Send current packages to the portal</button>
                </form>
            }
        }
    </div>
</div>

@if (button is not null)
{
    <div class="card">
        <div class="card-head"><h3>Button for your website</h3></div>
        <div class="card-body">
            <p class="muted small">Paste this into your website where the button should appear. Your web designer will know where.</p>
            <div style="margin:.5rem 0 1rem;">@Html.Raw(button)</div>
            <div class="contract-link">
                <input id="ssButton" type="text" readonly value="@button" aria-label="Button HTML" />
                <button type="button" class="btn btn-sm btn-outline" onclick="navigator.clipboard.writeText(document.getElementById('ssButton').value); this.textContent='Copied';">Copy code</button>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-head"><h3>Talk to an advisor</h3></div>
    <div class="card-body">
        <form asp-action="Settings" method="post" class="form-grid">
            <div class="field">
                <label for="advisorWhatsApp">WhatsApp number for the "Chat on WhatsApp" button</label>
                <input id="advisorWhatsApp" name="advisorWhatsApp" type="tel" value="@Model.AdvisorWhatsApp" placeholder="082 123 4567" />
                <span class="hint">Leave empty to show only "Ask for a call back". Call-back requests arrive under Applications.</span>
            </div>
            <div class="field" style="align-self:end;"><button type="submit" class="btn btn-outline">Save</button></div>
        </form>
    </div>
</div>

<p class="muted small">
    Packages change? Use <em>Send current packages to the portal</em> so the estimates clients see stay right.
    Estimates are labelled as estimates, not offers.
</p>
