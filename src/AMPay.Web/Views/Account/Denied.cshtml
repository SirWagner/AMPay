@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access denied &middot; AM-Pay</title>
    <link rel="stylesheet" href="~/css/ampay.css" asp-append-version="true" />
</head>
<body>
<div class="auth-page">
    <canvas class="network-bg" data-network="ambient" data-tone="dark" aria-hidden="true"></canvas>
    <div class="auth-card">
        <img src="~/img/ampay-logo.png" alt="AM-Pay Fintech" class="auth-logo" width="163" height="32" />

        <h1 style="font-size:1.25rem;">Access denied</h1>
        <p class="muted small">
            Your account does not have permission to open that page. If you believe it should,
            ask your administrator to review your role.
        </p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-outline">Back to the dashboard</a>
    </div>
</div>
<script src="~/js/network.js" asp-append-version="true"></script>
</body>
</html>
