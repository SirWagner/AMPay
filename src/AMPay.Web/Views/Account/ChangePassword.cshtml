@model AMPay.Web.Controllers.ChangePasswordViewModel
@{
    var forced = ViewBag.Forced is true;
}

<div class="page-head">
    <h1>Change password</h1>
    <p class="lede">
        @if (forced)
        {
            <text>You are signed in with a password an administrator set for you. Choose your own before you continue - the administrator knows the current one.</text>
        }
        else
        {
            <text>Choose a new password for your account.</text>
        }
    </p>
</div>

<form asp-action="ChangePassword" method="post" style="max-width:34rem;">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="card">
        <div class="card-body">
            <div class="field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" autocomplete="new-password" />
                <span class="hint">At least 12 characters, with an uppercase letter, a digit and a symbol.</span>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>
        <div class="card-foot">
            <button type="submit" class="btn btn-primary">Change password</button>
            @if (!forced)
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline">Cancel</a>
            }
        </div>
    </div>
</form>
