@model AMPay.Web.Models.TenantModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-head">
    <h1>@Model.Name</h1>
    <p class="lede">Customer details and Netcash account.</p>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_TenantForm" model="Model" />
    <div class="card">
        <div class="card-foot">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-controller="ServiceKeys" asp-action="Index" asp-route-tenantId="@Model.Id"
               class="btn btn-navy">Service keys</a>
            <a asp-action="Index" class="btn btn-outline">Back</a>
        </div>
    </div>
</form>
