@using Microsoft.Extensions.Options
@using AMPay.Portal.Services
@inject IOptions<PortalOptions> Options
@{
    var lender = ViewData["Lender"] as Lender;
    var signedIn = lender is not null && User.Identity?.IsAuthenticated == true &&
                   User.FindFirst(ApplicantClaims.LenderId)?.Value == lender.Id.ToString();
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"]@(lender is null ? "" : " · " + lender.DisplayName)</title>
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
</head>
@{
    var here = Context.Request.Path.Value ?? "";
    string? Cur(string part) => here.Contains(part) ? "page" : null;
}
<body class="@(signedIn ? "has-tabs" : "")">
@if (Options.Value.UseStubs)
{
    <div class="test-banner" role="note">Test system. Codes show on screen.</div>
}
<div class="stage">
<canvas class="network-bg" data-network="ambient" data-tone="dark" aria-hidden="true"></canvas>
<header class="top">
    <div class="top-inner">
        <div>
            @if (lender is not null)
            {
                <a href="/a/@lender.PublicCode" class="lender-brand">
                    @if (lender.LogoUpdatedUtc is { } logoV)
                    {
                        <span class="lender-logo"><img src="/a/@lender.PublicCode/logo?v=@logoV.Ticks" alt="" /></span>
                    }
                    <strong>@lender.DisplayName</strong>
                </a>
                @if (!string.IsNullOrWhiteSpace(lender.NcrNumber))
                {
                    <div class="ncr">Registered credit provider @lender.NcrNumber</div>
                }
            }
            else
            {
                <strong>AM-Pay Loan Flow</strong>
            }
        </div>
        @if (signedIn)
        {
            <div class="top-actions">
                <nav class="account-nav" aria-label="Your pages">
                    <a href="/a/@lender!.PublicCode/account" aria-current="@Cur("/account")">My loans</a>
                    <a href="/a/@lender.PublicCode/application" aria-current="@Cur("/application")">Apply</a>
                    <a href="/a/@lender.PublicCode/advisor" aria-current="@Cur("/advisor")">Help</a>
                </nav>
                <form method="post" action="/a/@lender.PublicCode/signout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="linkish">Sign out</button>
                </form>
            </div>
        }
    </div>
</header>
</div>

<main class="wrap">
    @if (TempData["Success"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert alert-error" role="alert">@err</div> }
    @RenderBody()
</main>

@if (signedIn)
{
    <nav class="tabbar" aria-label="Main">
        <a href="/a/@lender!.PublicCode/account" aria-current="@Cur("/account")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v12H3z M3 11h18 M7 15h4" /></svg>My loans</a>
        <a href="/a/@lender.PublicCode/application" aria-current="@Cur("/application")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14 M5 12h14" /></svg>Apply</a>
        <a href="/a/@lender.PublicCode/advisor" aria-current="@Cur("/advisor")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z" /></svg>Help</a>
    </nav>
}

<footer class="foot">
    @if (lender is not null)
    {
        <p>
            Your information is collected for @lender.Name@(string.IsNullOrWhiteSpace(lender.NcrNumber) ? "" : $" (NCR {lender.NcrNumber})")
            to assess your loan application, as the National Credit Act requires, and is processed under POPIA.
            Questions: @(lender.ContactNumber ?? lender.ContactEmail ?? "contact the lender").
        </p>
    }
    <p>Powered by <strong>AM-Pay Loan Flow</strong> - secure loan applications.</p>
</footer>
<script src="~/js/network.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
