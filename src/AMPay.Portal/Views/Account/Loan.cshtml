@model LoanDetailModel
@{
    var l = (Lender)ViewData["Lender"]!;
    var loan = Model.Loan;
    var s = Model.Statement;
    var collecting = loan.Stage == "Active";
    var docs = (s.Documents ?? new List<PortalDocumentInfo>()).Where(d => d.LoanNumber == loan.LoanNumber).ToList();
    var thisMonth = new DateTime(Model.UpdatedUtc.AddHours(2).Year, Model.UpdatedUtc.AddHours(2).Month, 1);
}

<p class="no-print"><a class="back" href="/a/@l.PublicCode/account">&larr; My loans</a></p>

<section class="card next">
    <div class="loan-head">
        <h1 style="margin:0;">@Fmt.R(loan.Principal) loan</h1>
        <span class="pill @Fmt.StatusClass(loan.Status)">@loan.Status</span>
    </div>
    @if (loan.ArrearsAmount > 0)
    {
        <div class="alert alert-error" role="alert" style="margin:8px 0 0;">
            <strong>@Fmt.R(loan.ArrearsAmount) is overdue</strong>, by @loan.DaysPastDue day@(loan.DaysPastDue == 1 ? "" : "s").
            @if (l.ContactNumber is not null) { <text>Call <a href="tel:@l.ContactNumber">@l.ContactNumber</a>.</text> }
        </div>
    }
    @if (collecting)
    {
        <span class="muted">Next payment</span>
        <span class="next-amount">@(loan.NextDueAmount is null ? "Nothing due" : Fmt.R(loan.NextDueAmount))</span>
        @if (loan.NextDueDate is { } due) { <span>@due.ToString("dddd d MMMM yyyy")</span> }
        <span class="next-total"><span>Paid so far</span><strong>@Fmt.R(loan.PaidToDate)</strong></span>
        <span class="next-total"><span>Still to pay</span><strong>@Fmt.R(loan.RemainingInstalments)</strong></span>
        <span class="small muted">Paying off early costs less, because future interest and fees fall away. Ask @l.DisplayName for a settlement amount.</span>
    }
    else if (loan.Status == "Paid up")
    {
        <span>Paid in full@(loan.SettledOrClosedUtc is null ? "" : " on " + Fmt.D(loan.SettledOrClosedUtc.Value.AddHours(2))).</span>
    }
    else if (loan.Status == "Written off")
    {
        <span>Written off@(loan.SettledOrClosedUtc is null ? "" : " on " + Fmt.D(loan.SettledOrClosedUtc.Value.AddHours(2))) with @Fmt.R(loan.WrittenOffAmount) unpaid. Ask @l.DisplayName what this means for you.</span>
    }
    <span class="small muted">@loan.LoanNumber · @s.FullName · updated @Fmt.Sast(Model.UpdatedUtc)</span>
</section>

<details class="fold" open>
    <summary>Payments <span class="muted">@loan.Payments.Count</span></summary>
    @if (!loan.Payments.Any())
    {
        <p class="muted">No payments yet.</p>
    }
    <ul class="rows">
        @foreach (var p in loan.Payments)
        {
            <li>
                <span class="row-line"><strong>@Fmt.R(p.Amount)</strong><span class="pill @Fmt.StatusClass(p.Status)">@p.Status</span></span>
                <span class="small muted">@Fmt.D(p.Date) · @p.Method@(p.InstalmentNumber is { } n ? $" · instalment {n}" : "")@(p.Reference is null ? "" : $" · ref {p.Reference}")</span>
                @if (p.Reason is not null) { <span class="small">@p.Reason@(p.RecoveredLater ? ". Paid later another way." : "")</span> }
            </li>
        }
    </ul>
</details>

@if (loan.Schedule.Any())
{
    <details class="fold" @(collecting ? "open" : null)>
        <summary>Instalments <span class="muted">@loan.InstalmentsPaid of @loan.Schedule.Count paid</span></summary>
        <ul class="rows">
            @foreach (var e in loan.Schedule)
            {
                <li>
                    <details class="inst">
                        <summary>
                            <span class="row-line"><span>@Fmt.D(e.DueDate)</span><strong>@Fmt.R(e.Total)</strong></span>
                            <span class="pill @Fmt.StatusClass(e.Status)">@e.Status</span>
                        </summary>
                        <table class="money small">
                            <tbody>
                                <tr><th scope="row">Capital</th><td>@Fmt.R(e.Capital)</td></tr>
                                <tr><th scope="row">Interest</th><td>@Fmt.R(e.Interest)</td></tr>
                                <tr><th scope="row">Service fee</th><td>@Fmt.R(e.ServiceFee)</td></tr>
                                <tr><th scope="row">Credit life</th><td>@Fmt.R(e.CreditLife)</td></tr>
                                @if (loan.TotalVat > 0) { <tr><th scope="row">VAT</th><td>@Fmt.R(e.Vat)</td></tr> }
                                <tr class="sub"><th scope="row">Paid</th><td>@Fmt.R(e.Paid)</td></tr>
                                <tr><th scope="row">Balance after</th><td>@Fmt.R(e.ClosingBalance)</td></tr>
                            </tbody>
                        </table>
                    </details>
                </li>
            }
        </ul>
        <p class="small muted">Tap an instalment to see what it is made of.</p>
    </details>
}

<details class="fold" @(docs.Any() ? "open" : null)>
    <summary>Documents</summary>
    <ul class="loan-list">
        @foreach (var d in docs)
        {
            <li><a href="/a/@l.PublicCode/account/document/@d.Key"><span class="loan-head"><span><strong>@d.Title</strong><br /><span class="small muted">PDF · @Fmt.Sast(d.DatedUtc)</span></span><span class="pill pill-done">Download</span></span></a></li>
        }
        @if (loan.Stage != "Pending")
        {
            <li><a href="/a/@l.PublicCode/account/loan/@loan.LoanNumber/statement"><span class="loan-head"><span><strong>Full statement of account</strong><br /><span class="small muted">Every instalment and payment since the start</span></span><span class="pill pill-todo">Open</span></span></a></li>
            <li><a href="/a/@l.PublicCode/account/loan/@loan.LoanNumber/statement?from=@thisMonth.AddMonths(-1).ToString("yyyy-MM-dd")&to=@thisMonth.AddDays(-1).ToString("yyyy-MM-dd")"><span class="loan-head"><span><strong>Last month's statement</strong><br /><span class="small muted">@thisMonth.AddMonths(-1).ToString("MMMM yyyy")</span></span><span class="pill pill-todo">Open</span></span></a></li>
        }
        @if (loan.Status == "Paid up")
        {
            <li><a href="/a/@l.PublicCode/account/loan/@loan.LoanNumber/paid-up"><span class="loan-head"><span><strong>Paid-up letter</strong><br /><span class="small muted">Confirms the loan is paid in full</span></span><span class="pill pill-done">Open</span></span></a></li>
        }
        @if (!docs.Any() && loan.Stage != "Pending")
        {
            <li class="small muted" style="padding:10px 0;">Your signed agreement appears here once it is signed.</li>
        }
    </ul>
</details>

@if (loan.DebitOrder is { } m)
{
    <details class="fold">
        <summary>Debit order <span class="pill @Fmt.StatusClass(m.Status)">@m.Status</span></summary>
        @if (m.StatusHelp is not null) { <p class="small">@m.StatusHelp</p> }
        <dl class="summary">
            <dt>Amount</dt><dd>@Fmt.R(m.Amount) @m.Frequency.ToLowerInvariant()@(m.FirstAmount is { } fa ? $" (first debit {Fmt.R(fa)})" : "")</dd>
            @if (m.FirstDate is not null) { <dt>First debit</dt><dd>@Fmt.D(m.FirstDate)</dd> }
            @if (m.Bank is not null) { <dt>From your account</dt><dd>@m.Bank @m.MaskedAccount</dd> }
            @if (m.MandateReference is not null) { <dt>Mandate reference</dt><dd>@m.MandateReference</dd> }
            @if (m.ApprovedUtc is not null) { <dt>You approved it</dt><dd>@Fmt.Sast(m.ApprovedUtc)</dd> }
        </dl>
        <p class="small muted">This is a DebiCheck debit order: your bank only pays what you approved. It will show on your bank statement with the mandate reference.</p>
    </details>
}

<details class="fold">
    <summary>What it costs <span class="muted">@Fmt.R(loan.TotalRepayable) in total</span></summary>
    <table class="money">
        <tbody>
            <tr><th scope="row">Amount you received</th><td>@Fmt.R(loan.Principal)</td></tr>
            <tr><th scope="row">Initiation fee (once-off, added to the loan)</th><td>@Fmt.R(loan.InitiationFee)</td></tr>
            @if (loan.ThirdPartyPayment > 0) { <tr><th scope="row">Paid to a third party for you</th><td>@Fmt.R(loan.ThirdPartyPayment)</td></tr> }
            <tr class="sub"><th scope="row">Total amount borrowed</th><td>@Fmt.R(loan.CapitalisedAmount)</td></tr>
            <tr><th scope="row">Interest (@Fmt.Pct(loan.MonthlyInterestRate) a month)</th><td>@Fmt.R(loan.TotalInterest)</td></tr>
            <tr><th scope="row">Service fees (@Fmt.R(loan.MonthlyServiceFee) a month)</th><td>@Fmt.R(loan.TotalServiceFees)</td></tr>
            @if (loan.TotalVat > 0) { <tr><th scope="row">VAT on fees (@Fmt.Pct(loan.VatRate))</th><td>@Fmt.R(loan.TotalVat)</td></tr> }
            <tr><th scope="row">Credit life insurance@(loan.CreditLifeRate > 0 ? $" ({Fmt.Pct(loan.CreditLifeRate)} a month)" : "")</th><td>@Fmt.R(loan.TotalCreditLife)</td></tr>
            @if (loan.FuneralCover > 0) { <tr><th scope="row">Funeral cover you chose</th><td>@Fmt.R(loan.FuneralCover)</td></tr> }
            <tr class="sub"><th scope="row">Total cost of credit</th><td>@Fmt.R(loan.TotalCostOfCredit)</td></tr>
            <tr class="total"><th scope="row">Total you repay</th><td>@Fmt.R(loan.TotalRepayable)</td></tr>
        </tbody>
    </table>
    <dl class="summary" style="margin-top:12px;">
        @if (loan.CreditCostMultiple > 0) { <dt>Cost of credit multiple</dt><dd>@loan.CreditCostMultiple.ToString("0.00") (you repay @loan.CreditCostMultiple.ToString("0.00") times what you borrowed)</dd> }
        <dt>Instalments</dt><dd>@loan.NumberOfInstalments, @loan.Frequency.ToLowerInvariant()@(loan.FirstInstalment != loan.BaseInstalment && loan.FirstInstalment > 0 ? $" - first {Fmt.R(loan.FirstInstalment)}" : "")</dd>
        @if (loan.ProductType is not null) { <dt>Type of credit</dt><dd>@loan.ProductType</dd> }
        @if (loan.PackageName is not null) { <dt>Product</dt><dd>@loan.PackageName</dd> }
        <dt>Agreement date</dt><dd>@Fmt.D(loan.AgreementDate)</dd>
        <dt>Paid out</dt><dd>@Fmt.Sast(loan.DisbursedUtc)</dd>
        <dt>First collection</dt><dd>@Fmt.D(loan.FirstCollectionDate)</dd>
    </dl>
</details>

<div class="actions no-print">
    <a class="btn btn-outline" href="/a/@l.PublicCode/advisor">Something not right? Tell us</a>
    <button type="button" class="btn btn-outline" onclick="window.print()">Print or save</button>
</div>

@section Scripts {
<script>
// A printed loan shows everything, whatever was folded on screen.
window.addEventListener('beforeprint', function () { document.querySelectorAll('details').forEach(function (d) { d.open = true; }); });
</script>
}
