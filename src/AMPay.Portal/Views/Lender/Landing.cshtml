@model LandingModel
@{
    ViewData["Title"] = "Welcome";
    var l = Model.Lender;
    var wa = l.WhatsAppNumber is null ? null
        : $"https://wa.me/{l.WhatsAppNumber}?text={Uri.EscapeDataString($"Hello {l.DisplayName}, I would like to ask about a loan.")}";
    var apply = Model.SignedIn ? $"/a/{l.PublicCode}/application" : $"/a/{l.PublicCode}/start";
    var loans = Model.SignedIn ? $"/a/{l.PublicCode}/account" : $"/a/{l.PublicCode}/start?to=account";
}

<div class="card">
    <h1>What would you like to do?</h1>
    <div class="choices">
        <a class="choice choice-main" href="@apply">
            <span><strong>Apply for a loan</strong>
                <span>@if (Model.Range is { } r) { <text>R @r.MinAmount.ToString("N0") to R @r.MaxAmount.ToString("N0"). </text> }Takes about 10 minutes.</span></span>
        </a>
        <a class="choice" href="@loans">
            <span><strong>See my loans</strong><span>Payments, statements, and documents to sign.</span></span>
        </a>
    </div>
    <p class="small muted" style="margin:14px 0 0;">You sign in with a code sent to your cell. No password.</p>
</div>

<details class="fold">
    <summary>What you need to apply</summary>
    <ul class="plain">
        <li>Your South African ID</li>
        <li>Your latest payslip (a phone photo is fine)</li>
        <li>@l.DisplayName then checks that you can afford the loan, as the National Credit Act requires, and contacts you.</li>
    </ul>
</details>

<div class="card">
    <h2>Need help?</h2>
    <div class="actions" style="margin-top:0;">
        <a class="btn btn-outline" href="/a/@l.PublicCode/advisor">Call me back</a>
        @if (wa is not null)
        {
            <a class="btn btn-whatsapp" href="@wa" target="_blank" rel="noopener noreferrer">WhatsApp us</a>
        }
    </div>
</div>
